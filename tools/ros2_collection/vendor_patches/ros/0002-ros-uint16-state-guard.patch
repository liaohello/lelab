+def _set_uint16_state(data, field, state):
+    """Assign a ROS uint16[] field only when the raw reply can be represented."""
+    if (not isinstance(state, (list, tuple)) or not state
+            or any(type(value) is not int or not 0 <= value <= 65535
+                   for value in state)):
+        return False
+    setattr(data, field, state)
+    return True
+
+
+def _set_position_state(data, state):
+    """Carry the protocol's signed int16 position through ROS uint16[] unchanged."""
+    if (not isinstance(state, (list, tuple)) or len(state) != 1
+            or type(state[0]) is not int or not -32768 <= state[0] <= 32767):
+        return False
+    data.position = [state[0] & 0xffff]
+    return True
+
