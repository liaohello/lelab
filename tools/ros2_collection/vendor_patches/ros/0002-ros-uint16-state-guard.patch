+    def recover_bus_servo_reads(self, quiet_s=0.2):
+        """Clear the read latch only after the serialized bus is quiet."""
+        board = self.board
+        if not board.servo_read_lock.acquire(timeout=quiet_s):
+            return False
+        try:
+            with board.bus_reply_lock:
+                while True:
+                    try:
+                        board.bus_servo_queue.get_nowait()
+                    except Exception:
+                        break
+                board.bus_reply_active = False
+                board.bus_reply_fault = False
+            time.sleep(quiet_s)
+            with board.bus_reply_lock:
+                if board.bus_reply_fault or not board.bus_servo_queue.empty():
+                    while True:
+                        try:
+                            board.bus_servo_queue.get_nowait()
+                        except Exception:
+                            break
+                    board.bus_reply_active = False
+                    board.bus_reply_fault = True
+                    return False
+                board.bus_reply_active = False
+                board.bus_reply_fault = False
+                return True
+        finally:
+            board.servo_read_lock.release()
