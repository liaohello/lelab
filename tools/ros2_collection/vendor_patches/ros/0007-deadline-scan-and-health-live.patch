+    def _bounded_bus_write(self, writer, *args):
+        # All bus writes share the read lock, with a bounded wait and a record.
+        if not self.board.servo_read_lock.acquire(
+                timeout=self.servo_readback_lock_timeout_s):
+            self.servo_readback_health.record_write_failure('bus_lock_timeout')
+            self.get_logger().warning('bus write dropped: bus lock timeout')
+            return False
+        try:
+            writer(*args)
+            return True
+        except IOError as error:
+            self.servo_readback_health.record_write_failure(str(error))
+            self.get_logger().warning(f'bus write dropped: {error}')
+            return False
+        finally:
+            self.board.servo_read_lock.release()
+
