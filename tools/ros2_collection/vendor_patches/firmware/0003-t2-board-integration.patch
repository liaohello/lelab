--- a/Hiwonder/System/t2_board.h
+++ b/Hiwonder/System/t2_board.h
@@ -0,0 +1,21 @@
+#ifndef LELAB_T2_BOARD_H
+#define LELAB_T2_BOARD_H
+#include <stddef.h>
+#include <stdint.h>
+#include "t2_protocol.h"
+
+/* Board glue for the T2 increment. t2_protocol.c is hardware-independent and
+ * is host-tested; this file needs the STM32 HAL/FreeRTOS project and is NOT
+ * compiled by the host harness. */
+t2_state *t2_board_state(void);
+const uint8_t *t2_board_build_id(void);
+void t2_board_init(void);
+void t2_board_on_frame(const uint8_t *frame, size_t len);
+/* Called from TIM7 IRQ (10 ms). Pure memory work: no malloc, no UART, no wait. */
+void t2_isr_tick(void);
+/* Called from the app task. packet_transmit uses the existing DMA queue. */
+void t2_task_emit_snapshot(void);
+/* Override with a genuinely fresh 128-bit id per power-on. The default returns
+ * 0 so the board fails closed: no capability report, no snapshot, no command. */
+int t2_board_get_boot_id(uint8_t out[16]);
+#endif
--- a/Hiwonder/System/t2_board.c
+++ b/Hiwonder/System/t2_board.c
@@ -0,0 +1,121 @@
+#include "t2_board.h"
+#include "global.h"
+#include "tim.h"
+#include "packet.h"
+#include <string.h>
+
+/* PLACEHOLDER only. A reproducible ARM build must replace this with the first
+ * 16 bytes of the SHA-256 of its own fresh hex; it must never be reported as
+ * the identity of the .hex already present in the reference tree. */
+static uint8_t g_t2_build_id[16] = "T2-UNBUILT-0001";
+static t2_state g_t2_state;
+static t2_sampler g_t2_sampler;
+static uint8_t g_t2_boot_id[16];
+static uint32_t g_t2_tick_ms;
+static uint32_t g_t2_sample_seq;
+static int g_t2_ready;
+
+#if defined(__GNUC__)
+__attribute__((weak))
+#endif
+int t2_board_get_boot_id(uint8_t out[16])
+{
+    /* No verified entropy/persistence source in this offline wave. Fail closed:
+     * a real build MUST override this (UID + non-volatile boot counter + RTC,
+     * validated across software reset AND power loss). */
+    (void)out;
+    return 0;
+}
+
+t2_state *t2_board_state(void) { return &g_t2_state; }
+const uint8_t *t2_board_build_id(void) { return g_t2_build_id; }
+
+void t2_board_init(void)
+{
+    memset(&g_t2_state, 0, sizeof(g_t2_state));
+    memset(g_t2_boot_id, 0, sizeof(g_t2_boot_id));
+    t2_sampler_init(&g_t2_sampler);
+    g_t2_tick_ms = 0;
+    g_t2_sample_seq = 0;
+    g_t2_ready = 0;
+    if (t2_board_get_boot_id(g_t2_boot_id) && t2_init(&g_t2_state, g_t2_boot_id)) {
+        g_t2_ready = 1;
+    }
+    /* g_t2_ready == 0 -> boot_valid == 0 -> no CAP_REPORT, no snapshot,
+     * and t2_command_ex returns REJ_DISABLED_BOOT for every command. */
+}
+
+void t2_board_on_frame(const uint8_t *frame, size_t len)
+{
+    /* packet_rx task context; t2_expire() inside also runs here at the current
+     * board tick, but the ISR calls it every 10 ms independently of traffic. */
+    (void)t2_command_ex(&g_t2_state, frame, len, g_t2_tick_ms);
+}
+
+static uint32_t t2_counter_of(unsigned i)
+{
+    switch (i) {
+        case 0: return __HAL_TIM_GET_COUNTER(&htim5);
+        case 1: return __HAL_TIM_GET_COUNTER(&htim2);
+        case 2: return __HAL_TIM_GET_COUNTER(&htim4);
+        default: return __HAL_TIM_GET_COUNTER(&htim3);
+    }
+}
+
+void t2_isr_tick(void)
+{
+    t2_sample snap;
+    unsigned i;
+    int consistent = 1;
+    g_t2_tick_ms += 10u;                      /* TIM7 period is 10 ms */
+    t2_expire(&g_t2_state, g_t2_tick_ms);    /* independent of UART and IWDG */
+    if (!g_t2_state.enabled) {
+        /* Only override the setpoint; PID gains, kinematics and PWM calls are
+         * left exactly as the vendor implementation. */
+        for (i = 0; i < T2_WHEELS; ++i) {
+            motors[i]->pid_controller.set_point = 0.0f;
+        }
+    }
+    memset(&snap, 0, sizeof(snap));
+    snap.tick_ms = g_t2_tick_ms;
+    snap.sample_seq = ++g_t2_sample_seq;
+    snap.faults = g_t2_state.faults | g_t2_state.latched_faults;
+    for (i = 0; i < T2_WHEELS; ++i) {
+        int64_t before = motors[i]->overflow_num;
+        uint32_t counter = t2_counter_of(i);
+        int64_t after = motors[i]->overflow_num;
+        int64_t count = 0;
+        if (!t2_compose_count_checked(before, counter, after,
+                                      T2_TICKS_OVERFLOW, &count)) {
+            consistent = 0;   /* rollover raced the read; do not publish a torn count */
+            break;
+        }
+        snap.count[i] = count;
+        snap.measured_rps[i] = motors[i]->rps;  /* encoder-derived, NOT the setpoint */
+        snap.target_rps[i] = g_t2_state.enabled ? g_t2_state.target[i] : 0.0f;
+    }
+    if (!consistent) {
+        g_t2_state.faults |= T2_FAULT_ENCODER_INVALID;
+        return;                 /* skip this cycle, never emit a half frame */
+    }
+    t2_sampler_publish(&g_t2_sampler, &snap);  /* seqlock copy, no serial I/O */
+}
+
+void t2_task_emit_snapshot(void)
+{
+    uint8_t frame[T2_FRAME_MAX];
+    t2_sample s;
+    size_t n;
+    if (!g_t2_ready) return;                 /* fail closed without a fresh boot id */
+    if (!t2_sampler_read(&g_t2_sampler, &s)) {
+        g_t2_state.faults |= T2_FAULT_SNAPSHOT_STALE;
+        return;
+    }
+    n = t2_snapshot(&g_t2_state, &s, frame, sizeof(frame));
+    if (n < 5) {
+        g_t2_state.faults |= T2_FAULT_SNAPSHOT_STALE;
+        return;
+    }
+    /* task context: packet_transmit mallocs and enqueues onto the existing DMA queue */
+    packet_transmit(&packet_controller, PACKET_FUNC_LELAB_T2, frame + 4, n - 5);
+}
