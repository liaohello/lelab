+/* T2: runs in packet_rx task context, never in the motor ISR. */
+static void packet_t2_handle(struct PacketRawFrame *frame)
+{
+    uint8_t reply[T2_FRAME_MAX];
+    size_t n;
+    if(frame->data_length > 0 && frame->data_and_checksum[0] == T2_SUB_CAP_QUERY) {
+        n = t2_capabilities(t2_board_state(), t2_board_build_id(), reply, sizeof(reply));
+        if(n > 5) {
+            packet_transmit(&packet_controller, PACKET_FUNC_LELAB_T2, reply + 4, n - 5);
+        }
+        return;
+    }
+    /* PacketRawFrame is packed: the struct bytes ARE the wire frame. */
+    t2_board_on_frame((const uint8_t *)frame, (size_t)frame->data_length + 5u);
+}
