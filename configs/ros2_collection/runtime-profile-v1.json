    "base_frame": "base_footprint",
    "odom_frame": "odom",
    "world_frame": "pick_place"
  },
  "task": {
    "id": "approach_pick_place_cube",
    "language": "Approach the orange cube, grasp it with the wrist-mounted gripper and place it in the blue container.",
