      ],
      "units": ["m/s", "m/s", "rad/s", "rad", "rad", "rad", "rad", "rad", "rad"],
      "frame": "base_footprint",
      "source": "gazebo_measured"
    },
    "action": {
      "name": "action",
      "names": [
        "base_vx",
        "base_vy",
        "base_wz",
        "joint1.target",
        "joint2.target",
        "joint3.target",
        "joint4.target",
        "joint5.target",
        "gripper_base.target"
      ],
      "units": ["m/s", "m/s", "rad/s", "rad", "rad", "rad", "rad", "rad", "rad"],
      "source": "gateway_applied_target"
    },
    "auxiliary_raw_only": [
      "/lelab/wrist/depth/image_raw",
      "/lelab/wrist/depth/camera_info",
      "/lelab/lidar/scan",
      "/lelab/imu",
      "/lelab/contacts"
    ]
  },
  "limits": {
    "base_vx_mps": 0.30,
    "base_vy_mps": 0.30,
    "base_wz_radps": 1.0,
    "joint_positions_rad": {
      "joint1": [-2.09, 2.09],
      "joint2": [-2.09, 2.09],
      "joint3": [-2.09, 2.09],
      "joint4": [-2.09, 2.09],
      "joint5": [-2.09, 2.09]
    },
    "gripper_base_rad": [-1.638, 0.0],
    "base_command_ttl_s": 0.30,
    "arm_command_ttl_s": 2.5,
    "max_trajectory_duration_s": 4.0,
    "control_session_ttl_s": 30.0,
    "heartbeat_timeout_s": 0.5,
    "watchdog_web_stale_s": 1.5
