    "base_joints": [
      "wheel_left_front_joint",
      "wheel_left_back_joint",
      "wheel_right_front_joint",
      "wheel_right_back_joint"
    ],
    "arm_joints": ["joint1", "joint2", "joint3", "joint4", "joint5"],
    "gripper_master_joint": "gripper_base_joint",
