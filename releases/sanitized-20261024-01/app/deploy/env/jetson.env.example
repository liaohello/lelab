# Copy to /home/nvidia/Desktop/lelab/shared/config/jetson.env and chmod 600.
# This file intentionally contains no credentials.

LELAB_ROLE=jetson-primary
LELAB_PROJECT_ROOT=/home/nvidia/Desktop/lelab
LELAB_RELEASE_ROOT=/home/nvidia/Desktop/lelab/releases
LELAB_CURRENT=/home/nvidia/Desktop/lelab/current
LELAB_SHARED_ROOT=/home/nvidia/Desktop/lelab/shared

# Keep the API on loopback and view it from Windows through the SSH tunnel.
# Only change to 0.0.0.0 after API authentication and a LAN firewall rule exist.
LELAB_BIND_HOST=127.0.0.1
LELAB_PORT=8000

# Persistent local/private data. Dataset upload to the Hub is not part of this deployment.
HF_HOME=/home/nvidia/Desktop/lelab/shared/huggingface
HF_LEROBOT_HOME=/home/nvidia/Desktop/lelab/shared/lerobot
HF_LEROBOT_CALIBRATION=/home/nvidia/Desktop/lelab/shared/calibration
LELAB_DATASET_ROOT=/home/nvidia/Desktop/lelab/shared/datasets
LELAB_OUTPUT_ROOT=/home/nvidia/Desktop/lelab/shared/outputs

# Runtime selection. "container" is preferred on Jetson after compatibility audit.
LELAB_RUNTIME_MODE=container
# The NVIDIA image is only a candidate base. Audit JetPack/L4T compatibility first, then
# build the local application image with deploy/jetson/Containerfile.
LELAB_JETSON_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.04-py3-igpu
LELAB_JETSON_IMAGE=lelab-jetson:local
LELAB_NATIVE_VENV=/home/nvidia/Desktop/lelab/shared/venv

# Explicit device allow-list. The launcher never sends commands to these devices.
# Fill these only after checking stable /dev/serial/by-id links and camera indices.
LELAB_SERIAL_DEVICES=
LELAB_VIDEO_DEVICES=

# Safety defaults consumed by the deployment/control layer when supported.
LELAB_HARDWARE_LEASE_REQUIRED=1
LELAB_SAFETY_LIMITS_REQUIRED=1
LELAB_MAX_RELATIVE_TARGET=5
# Absolute workspace around the first commanded pose. Disabled 2026-09-19
# (debug_log case 4): the ACT policy needed ~28deg of travel from the startup
# pose, so the +-12deg window pinned elbow_flex/shoulder_lift and caused jitter.
# 'off' disables the guard; the relative per-step limit above stays active.
# Absolute per-joint bound from the calibration file (task-independent), in the
# same units as the commands (degrees when use_degrees=True). Positive values
# shrink the calibrated range, negative values expand it. -4 covers the
# red-bowl demos, which overshoot the measured calibration by up to 3.2 units,
# while still bounding runaway commands. 'off' disables it.
LELAB_CALIBRATION_RANGE_MARGIN=-4
LELAB_MAX_POSITION_DEVIATION=off
LELAB_ACTION_TTL_MS=250
LELAB_START_OBSERVE_ONLY=1

# Storage policy used by monitoring/recording guards.
LELAB_STORAGE_WARN_PERCENT=20
LELAB_STORAGE_CRITICAL_PERCENT=10
LELAB_STORAGE_STOP_RECORDING_PERCENT=5

# Optional Jetson-side download proxy. Do not copy this value to the public train host.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,192.0.2.21/24

# SSH training runtime. Use an absolute interpreter path because the detached
# remote shell does not activate a virtual environment. LELAB_TRAIN_PROXY is
# the train server's loopback end of the reverse Mihomo tunnel.
LELAB_TRAIN_PYTHON=/home/trainer/Desktop/lelab_server/app/.venv/bin/python
LELAB_TRAIN_PROXY=http://127.0.0.1:17890
# The public train host cannot reach huggingface.co directly. Point its HF
# client at the mirror unless the reverse Mihomo tunnel above is running.
LELAB_TRAIN_HF_ENDPOINT=https://hf-mirror.com

# The application may use this once API-token middleware is enabled. Keep loopback binding
# even when empty. Generate a random value; never commit the populated environment file.
LELAB_API_TOKEN=

# Preferred local inference endpoint. The remote train fallback is tunnelled to 127.0.0.1:28081.
LEROBOT_LOCAL_POLICY_HOST=127.0.0.1
LEROBOT_LOCAL_POLICY_PORT=8080
LEROBOT_POLICY_FPS=30
LEROBOT_POLICY_INFERENCE_LATENCY=0.033
LEROBOT_POLICY_OBS_QUEUE_TIMEOUT=1
