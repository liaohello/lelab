# Copy to /home/trainer/Desktop/lelab_server/shared/config/train.env and chmod 600.
# This file intentionally contains no credentials.

LELAB_ROLE=train-server
LELAB_PROJECT_ROOT=/home/trainer/Desktop/lelab_server
LELAB_CURRENT=/home/trainer/Desktop/lelab_server/current
LELAB_SHARED_ROOT=/home/trainer/Desktop/lelab_server/shared
LELAB_DATASET_ROOT=/home/trainer/Desktop/lelab_server/shared/datasets
LELAB_MODEL_ROOT=/home/trainer/Desktop/lelab_server/shared/models
LELAB_OUTPUT_ROOT=/home/trainer/Desktop/lelab_server/shared/outputs
HF_HOME=/home/trainer/Desktop/lelab_server/shared/huggingface
HF_LEROBOT_HOME=/home/trainer/Desktop/lelab_server/shared/lerobot

# Insecure gRPC must stay on loopback. Jetson reaches it through an SSH tunnel.
LEROBOT_POLICY_HOST=127.0.0.1
LEROBOT_POLICY_PORT=28081
LEROBOT_POLICY_FPS=30
LEROBOT_POLICY_INFERENCE_LATENCY=0.033
LEROBOT_POLICY_OBS_QUEUE_TIMEOUT=1

# Never configure the private Jetson/Windows proxy (192.0.2.23:7890) here: a public
# train host cannot route to it unless an intentional reverse tunnel is established.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
