# Windows cold-standby profile (no dedicated service; used by the PowerShell
# helpers under deploy/windows/ and by a local `lelab` run after USB handover).
#
# Copy to %USERPROFILE%\.config\lelab\windows.env and load it in the shell that
# starts LeLab. Never add it to the source release.

LELAB_ROLE=windows-standby

# Jetson is the primary controller; Windows only views it through an SSH
# tunnel (deploy/windows/open-jetson-ui-tunnel.ps1) until a physical takeover.
LELAB_JETSON_HOST=192.0.2.22
LELAB_JETSON_PORT=22
LELAB_JETSON_USER=nvidia
LELAB_JETSON_ROOT=Desktop/lelab

# Train server coordinates (same values as deploy/config/servers.example.toml).
LELAB_TRAIN_HOST=192.0.2.10
LELAB_TRAIN_PORT=22
LELAB_TRAIN_USER=trainer
LELAB_TRAIN_ROOT=~/Desktop/lelab_server

# Local bind stays loopback; use the tunnel so the arm API never reaches the LAN.
LELAB_BIND_HOST=127.0.0.1
LELAB_PORT=8000

# Windows hardware is addressed by COM port and camera index; these are
# machine-local and must never be copied to Jetson profiles.
# LELAB_LEADER_PORT=COM5
# LELAB_FOLLOWER_PORT=COM6

# Same data root layout as Jetson, but pointing at a local scratch disk.
HF_LEROBOT_HOME=C:\lelab-data\lerobot
LELAB_DATASET_ROOT=C:\lelab-data\datasets

# Safety defaults must match Jetson; the lease is enforced by the API.
LELAB_HARDWARE_LEASE_REQUIRED=1
LELAB_SAFETY_LIMITS_REQUIRED=1
LELAB_MAX_RELATIVE_TARGET=5
LELAB_MAX_POSITION_DEVIATION=12
LELAB_ACTION_TTL_MS=250
LELAB_START_OBSERVE_ONLY=1

# Calibration may be restored from the encrypted Jetson backup.
# HF_LEROBOT_CALIBRATION=C:\lelab-data\calibration
