# Keep line endings consistent across Windows, WSL, and Linux checkouts.
# The repository stores text as LF; Windows may check it out as CRLF.
* text=auto

# Linux deployment targets must receive LF even when checked out on Windows.
*.sh text eol=lf
*.bash text eol=lf

# Windows-only helpers keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
